{
  "name": "chrono-duel",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "時間を支払って行動する対戦カードゲーム",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "tsx src/sim/simulate.ts",
    "wiki:stats": "tsx src/sim/wikistats.ts",
    "test:net": "tsx src/sim/nettest.ts",
    "test:econ": "tsx src/sim/econtest.ts",
    "test:meta": "tsx src/sim/metatest.ts",
    "test:rating": "tsx src/sim/ratingtest.ts",
    "dev:server": "tsx server/dev.ts",
    "test:stats": "tsx src/sim/statstest.ts",
    "stats:real": "tsx src/sim/realstats.ts",
    "balance": "tsx src/sim/balance.ts",
